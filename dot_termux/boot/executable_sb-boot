#!/data/data/com.termux/files/usr/bin/sh
export PATH=/data/data/com.termux/files/usr/bin:$PATH
URL=https://raw.githubusercontent.com/ishianecho/vpn/main/generated/sing-box-android.json
STATE=/data/data/com.termux/files/home/.cache/sing-box
CONFIG=$STATE/sing-box.json
case "${1:-start}" in
  start)
    mkdir -p "$STATE"
    if curl -fsSL "$URL" -o "$CONFIG.tmp"; then
      mv "$CONFIG.tmp" "$CONFIG"
    else
      rm -f "$CONFIG.tmp"
    fi
    [ -f "$CONFIG" ] || {
      echo "no config: $URL" >&2
      exit 1
    }
    termux-wake-lock
    su -c "nohup /data/data/com.termux/files/usr/bin/sing-box run -D $STATE -c $CONFIG >/dev/null 2>&1 &"
    ;;
  stop)
    su -c "pkill -f 'sing-box run'"
    ;;
  *)
    echo "Usage: sb-boot [start|stop]" >&2
    exit 1
    ;;
esac
