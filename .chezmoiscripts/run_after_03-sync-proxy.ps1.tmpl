$ErrorActionPreference = "Stop"

$configHome = Join-Path $env:USERPROFILE ".config"
$configPath = Join-Path $configHome "proxy\config"
if (-not (Test-Path -LiteralPath $configPath -PathType Leaf)) {
    exit 0
}

$proxy = Join-Path $env:USERPROFILE ".local\bin\proxy.exe"
if (-not (Test-Path -LiteralPath $proxy -PathType Leaf)) {
    Write-Warning "proxy.exe is not installed; skipping proxy synchronization."
    exit 0
}

& $proxy sync
if ($LASTEXITCODE -ne 0) {
    exit $LASTEXITCODE
}
