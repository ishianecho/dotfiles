$ErrorActionPreference = "Stop"

$env:CC_SWITCH_CONFIG_DIR = Join-Path $HOME ".config\cc-switch"

$dotfilesEnvironment = Join-Path $HOME ".config\env.ps1"
if (Test-Path -LiteralPath $dotfilesEnvironment -PathType Leaf) {
    . $dotfilesEnvironment
}

function Expand-EnvironmentTemplate {
    param([Parameter(Mandatory = $true)][string]$Content)

    $text = $Content
    while ($text -match '\$\{([A-Za-z_][A-Za-z0-9_]*)\}') {
        $name = $Matches[1]
        $value = [System.Environment]::GetEnvironmentVariable($name)
        if ([string]::IsNullOrEmpty($value)) {
            Write-Host "run_after_05-cc-switch: environment variable '$name' is not set, skipping"
            return $null
        }
        $text = $text.Replace('${' + $name + '}', $value)
    }
    $text
}

function Get-CCSwitchDefaultProvider {
    param([Parameter(Mandatory = $true)][string]$App)

    if ($App -eq "codex") {
        return "codex-official"
    }
    return "claude-official"
}

function Test-CCSwitchProvider {
    param(
        [Parameter(Mandatory = $true)][string]$App,
        [Parameter(Mandatory = $true)][string]$Id
    )

    $output = (cc-switch --app $App provider list 2>$null) -join "`n"
    if ($output -and $output -match "\b$([regex]::Escape($Id))\b") {
        return $true
    }
    Start-Sleep -Seconds 1
    $output = (cc-switch --app $App provider list 2>$null) -join "`n"
    return [bool]($output -and $output -match "\b$([regex]::Escape($Id))\b")
}

function Get-CCSwitchCurrentProvider {
    param([Parameter(Mandatory = $true)][string]$App)

    $output = (cc-switch --app $App provider current 2>$null) -join "`n"
    if ($LASTEXITCODE -eq 0 -and $output -match "ID:\s*(\S+)") {
        $current = $Matches[1]
    } else {
        $current = ""
    }
    if ($current -eq "" -or $current -eq "default") {
        return ""
    }
    return $current
}

function Switch-CCSwitchProvider {
    param(
        [Parameter(Mandatory = $true)][string]$App,
        [Parameter(Mandatory = $true)][string]$Provider
    )

    if (-not (Test-CCSwitchProvider -App $App -Id $Provider)) {
        $fallback = Get-CCSwitchDefaultProvider -App $App
        if (Test-CCSwitchProvider -App $App -Id $fallback) {
            Write-Host "run_after_05-cc-switch: provider '$Provider' not available for $App, using '$fallback'"
            $Provider = $fallback
        } else {
            Write-Host "run_after_05-cc-switch: provider list unavailable for $App, leaving current provider unchanged"
            return
        }
    }
    cc-switch --app $App provider switch $Provider
    if ($LASTEXITCODE -ne 0) {
        Write-Host "run_after_05-cc-switch: failed to switch $App provider, continuing"
    }
}

function Install-CCSwitchProviders {
    param(
        [Parameter(Mandatory = $true)][string]$App,
        [Parameter(Mandatory = $true)][string]$SeedPath
    )

    $seed = Get-Content -LiteralPath $SeedPath -Raw | ConvertFrom-Json
    foreach ($provider in $seed.PSObject.Properties) {
        if (Test-CCSwitchProvider -App $App -Id $provider.Name) {
            continue
        }

        $expanded = Expand-EnvironmentTemplate -Content ($provider.Value | ConvertTo-Json -Depth 30)
        if ($null -eq $expanded) {
            Write-Host "run_after_05-cc-switch: provider '$($provider.Name)' for $App skipped"
            continue
        }

        $temporaryPath = Join-Path $env:TEMP "cc-switch-$App-$($provider.Name).json"
        Set-Content -LiteralPath $temporaryPath -Value $expanded -Encoding utf8NoBOM
        cc-switch --app $App provider add `
            --id $provider.Name `
            --name $provider.Name `
            --config-file $temporaryPath `
            --common-config
        if ($LASTEXITCODE -ne 0) {
            exit $LASTEXITCODE
        }
        Remove-Item -LiteralPath $temporaryPath -Force
    }
}

function Set-CCSwitchCodexCommon {
    $base = Join-Path $env:CC_SWITCH_CONFIG_DIR "common-codex.toml"
    if (-not $env:CONTEXT7_API_KEY) {
        Write-Host "run_after_05-cc-switch: CONTEXT7_API_KEY is not set, skipping context7 for codex"
        cc-switch --app codex config common set --file $base
        if ($LASTEXITCODE -ne 0) {
            exit $LASTEXITCODE
        }
        return
    }

    $context7Command = "pnpm"
    $context7Args = '"dlx", "@upstash/context7-mcp"'
    $snippet = @"
[mcp_servers.context7]
command = "$context7Command"
args = [$context7Args]

[mcp_servers.context7.env]
CONTEXT7_API_KEY = "$($env:CONTEXT7_API_KEY)"
"@
    $temporaryPath = Join-Path $env:TEMP "cc-switch-common-codex.toml"
    (Get-Content -LiteralPath $base -Raw) + "`n" + $snippet | Set-Content -LiteralPath $temporaryPath -Encoding utf8NoBOM
    cc-switch --app codex config common set --file $temporaryPath
    if ($LASTEXITCODE -ne 0) {
        exit $LASTEXITCODE
    }
    Remove-Item -LiteralPath $temporaryPath -Force
}

if (-not (Get-Command cc-switch -ErrorAction SilentlyContinue)) {
    exit 0
}

$claudeProvider = Get-CCSwitchCurrentProvider -App claude
$codexProvider = Get-CCSwitchCurrentProvider -App codex

cc-switch --app claude config common set --file (Join-Path $env:CC_SWITCH_CONFIG_DIR "common-claude.json")
if ($LASTEXITCODE -ne 0) {
    exit $LASTEXITCODE
}
Set-CCSwitchCodexCommon

Install-CCSwitchProviders -App claude -SeedPath (Join-Path $env:CC_SWITCH_CONFIG_DIR "claude.json")
Install-CCSwitchProviders -App codex -SeedPath (Join-Path $env:CC_SWITCH_CONFIG_DIR "codex.json")

if ($claudeProvider) {
    Switch-CCSwitchProvider -App claude -Provider $claudeProvider
}
if ($codexProvider) {
    Switch-CCSwitchProvider -App codex -Provider $codexProvider
}
