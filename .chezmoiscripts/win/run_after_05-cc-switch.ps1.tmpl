$ErrorActionPreference = "Stop"

$env:CC_SWITCH_CONFIG_DIR = Join-Path $HOME ".config\cc-switch"

$dotfilesEnvironment = Join-Path $HOME ".config\env.ps1"
if (Test-Path -LiteralPath $dotfilesEnvironment -PathType Leaf) {
    . $dotfilesEnvironment
}

function Get-CCSwitchDefaultProvider {
    param([Parameter(Mandatory = $true)][string]$App)

    if ($App -eq "codex") {
        return "codex-official"
    }
    return "claude-official"
}

function Test-CCSwitchProvider {
    param(
        [Parameter(Mandatory = $true)][string]$App,
        [Parameter(Mandatory = $true)][string]$Id
    )

    $output = (cc-switch --app $App provider list 2>$null) -join "`n"
    if ($output -and $output -match "\b$([regex]::Escape($Id))\b") {
        return $true
    }
    Start-Sleep -Seconds 1
    $output = (cc-switch --app $App provider list 2>$null) -join "`n"
    return [bool]($output -and $output -match "\b$([regex]::Escape($Id))\b")
}

function Get-CCSwitchCurrentProvider {
    param([Parameter(Mandatory = $true)][string]$App)

    $output = (cc-switch --app $App provider current 2>$null) -join "`n"
    if ($LASTEXITCODE -eq 0 -and $output -match "ID:\s*(\S+)") {
        $current = $Matches[1]
    } else {
        $current = ""
    }
    if ($current -eq "" -or $current -eq "default") {
        return ""
    }
    return $current
}

function Switch-CCSwitchProvider {
    param(
        [Parameter(Mandatory = $true)][string]$App,
        [Parameter(Mandatory = $true)][string]$Provider
    )

    if (-not (Test-CCSwitchProvider -App $App -Id $Provider)) {
        $fallback = Get-CCSwitchDefaultProvider -App $App
        if (Test-CCSwitchProvider -App $App -Id $fallback) {
            $Provider = $fallback
        } else {
            return
        }
    }
    cc-switch --app $App provider switch $Provider
    if ($LASTEXITCODE -ne 0) {
        Write-Host "run_after_05-cc-switch: failed to switch $App provider, continuing"
    }
}

function New-CCSwitchProviderConfig {
    param(
        [Parameter(Mandatory = $true)][string]$App,
        [Parameter(Mandatory = $true)][string]$Id,
        [Parameter(Mandatory = $true)][string]$Key,
        [Parameter(Mandatory = $true)][string]$Base,
        [string]$Model,
        [string]$Wire
    )

    if ($App -eq "claude") {
        $providerEnv = [ordered]@{
            ANTHROPIC_BASE_URL = $Base
            ANTHROPIC_AUTH_TOKEN = $Key
        }
        if ($Model) {
            $providerEnv["ANTHROPIC_MODEL"] = $Model
        }
        return @{ env = $providerEnv } | ConvertTo-Json -Depth 10
    }

    $config = ""
    if ($Model) {
        $config += "model = `"$Model`"`n"
    }
    $config += "model_provider = `"$Id`"`n"
    $config += "model_catalog_json = `"~/.config/codex/models.json`"`n`n"
    $config += "[model_providers.$Id]`n"
    $config += "name = `"$Id`"`n"
    $config += "base_url = `"$Base`"`n"
    $config += "wire_api = `"$Wire`"`n"
    return @{ auth = @{ OPENAI_API_KEY = $Key }; config = $config } | ConvertTo-Json -Depth 10
}

function Install-CCSwitchProviders {
    param([Parameter(Mandatory = $true)][string]$App)

    $baseSuffix = "OPENAI"
    if ($App -eq "claude") {
        $baseSuffix = "ANTHROPIC"
    }

    $prefixes = Get-ChildItem env: |
        Where-Object { $_.Name -cmatch '^[A-Z0-9_]+_API_KEY$' } |
        ForEach-Object { $_.Name -replace '_API_KEY$', '' } |
        Sort-Object -Unique

    foreach ($prefix in $prefixes) {
        $key = [System.Environment]::GetEnvironmentVariable("${prefix}_API_KEY")
        if ([string]::IsNullOrEmpty($key)) {
            continue
        }
        $base = [System.Environment]::GetEnvironmentVariable("${prefix}_${baseSuffix}_BASE_URL")
        if ([string]::IsNullOrEmpty($base)) {
            continue
        }
        $model = [System.Environment]::GetEnvironmentVariable("${prefix}_MODEL")
        $wire = [System.Environment]::GetEnvironmentVariable("${prefix}_WIRE_API")
        if ([string]::IsNullOrEmpty($wire)) {
            $wire = "responses"
        }
        $id = ($prefix.ToLower()) -replace '_', '-'
        if (Test-CCSwitchProvider -App $App -Id $id) {
            continue
        }
        $json = New-CCSwitchProviderConfig -App $App -Id $id -Key $key -Base $base -Model $model -Wire $wire
        $temporaryPath = Join-Path $env:TEMP "cc-switch-$App-$id.json"
        Set-Content -LiteralPath $temporaryPath -Value $json -Encoding utf8NoBOM
        cc-switch --app $App provider add `
            --id $id `
            --name $id `
            --config-file $temporaryPath `
            --common-config | Out-Null
        if ($LASTEXITCODE -ne 0) {
            exit $LASTEXITCODE
        }
        Remove-Item -LiteralPath $temporaryPath -Force
    }
}

function Set-CCSwitchCodexCommon {
    $base = Join-Path $env:CC_SWITCH_CONFIG_DIR "common-codex.toml"
    if (-not $env:CONTEXT7_API_KEY) {
        cc-switch --app codex config common set --file $base | Out-Null
        if ($LASTEXITCODE -ne 0) {
            exit $LASTEXITCODE
        }
        return
    }

    $context7Command = "pnpm"
    $context7Args = '"dlx", "@upstash/context7-mcp"'
    $snippet = @"
[mcp_servers.context7]
command = "$context7Command"
args = [$context7Args]

[mcp_servers.context7.env]
CONTEXT7_API_KEY = "$($env:CONTEXT7_API_KEY)"
"@
    $temporaryPath = Join-Path $env:TEMP "cc-switch-common-codex.toml"
    (Get-Content -LiteralPath $base -Raw) + "`n" + $snippet | Set-Content -LiteralPath $temporaryPath -Encoding utf8NoBOM
    cc-switch --app codex config common set --file $temporaryPath | Out-Null
    if ($LASTEXITCODE -ne 0) {
        exit $LASTEXITCODE
    }
    Remove-Item -LiteralPath $temporaryPath -Force
}

if (-not (Get-Command cc-switch -ErrorAction SilentlyContinue)) {
    exit 0
}

$claudeProvider = Get-CCSwitchCurrentProvider -App claude
$codexProvider = Get-CCSwitchCurrentProvider -App codex

cc-switch --app claude config common set --file (Join-Path $env:CC_SWITCH_CONFIG_DIR "common-claude.json") | Out-Null
if ($LASTEXITCODE -ne 0) {
    exit $LASTEXITCODE
}
Set-CCSwitchCodexCommon

Install-CCSwitchProviders -App claude
Install-CCSwitchProviders -App codex

if ($claudeProvider) {
    Switch-CCSwitchProvider -App claude -Provider $claudeProvider
}
if ($codexProvider) {
    Switch-CCSwitchProvider -App codex -Provider $codexProvider
}
