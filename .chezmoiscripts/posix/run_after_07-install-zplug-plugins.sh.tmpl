#!/usr/bin/env bash

set -euo pipefail

zplug_init="${XDG_DATA_HOME:-$HOME/.local/share}/zplug/init.zsh"
[ -f "$zplug_init" ] || exit 0
[ -f "$HOME/.zshrc" ] || exit 0
command -v zsh > /dev/null 2>&1 || exit 0

ZPLUG_AUTO_INSTALL=1 zsh -i -l -c 'exit' || {
  echo "Warning: zplug plugin installation failed" >&2
  exit 0
}
