#!/usr/bin/env bash

set -euo pipefail

if ! grep -qw xray_tproxy /etc/group; then
  sudo groupadd -g 23333 xray_tproxy
fi
if ! id -nG "$(id -un)" | grep -qw xray_tproxy; then
  sudo usermod -aG xray_tproxy "$(id -un)"
  echo "Added $(id -un) to xray_tproxy; re-login required for 'sg xray_tproxy' and 'xrayctl direct'"
fi

xray_bin="$(command -v xray || true)"
if [ -z "$xray_bin" ]; then
  echo "xray not found; skipping Xray service setup"
  exit 0
fi

xray_config="{{ .chezmoi.homeDir }}/.config/xray/config.json"
xray_state="{{ .chezmoi.homeDir }}/.config/xray/state.json"
xray_env="{{ .chezmoi.homeDir }}/.config/xray/env"

if [ ! -f "$xray_state" ] && [ -f "$xray_env" ] && command -v xrayctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  xrayctl init
fi
if [ ! -f "$xray_state" ]; then
  echo "Xray state not found at $xray_state"
  echo "Run 'xrayctl init' or 'xrayctl node add <tag> vless://...'; skipping Xray service setup"
  exit 0
fi
if [ ! -f "$xray_config" ] && command -v xrayctl >/dev/null 2>&1; then
  xrayctl init
fi
if [ ! -f "$xray_config" ]; then
  echo "Xray config not found at $xray_config; skipping Xray service setup"
  exit 0
fi

if ! command -v systemctl >/dev/null 2>&1; then
  echo "systemd not found; skipping Xray service setup"
  exit 0
fi

if ! command -v sudo >/dev/null 2>&1; then
  echo "sudo not found; skipping Xray service setup"
  exit 0
fi

if ! sudo -n true >/dev/null 2>&1; then
  echo "sudo credentials required for Xray service setup; run 'sudo -v' then re-run"
  exit 0
fi

xray_asset_dir="$(dirname "$(readlink -f "$xray_bin")")"
for asset in geosite.dat geoip.dat; do
  if [ ! -f "$xray_asset_dir/$asset" ] && [ ! -f "/usr/share/xray/$asset" ]; then
    echo "Downloading $asset to $xray_asset_dir..."
    asset_tmp="$(mktemp)"
    if curl -fL --progress-bar -o "$asset_tmp" "https://github.com/v2fly/v2ray-core/releases/latest/download/$asset"; then
      sudo install -m 0644 "$asset_tmp" "$xray_asset_dir/$asset"
    else
      echo "Warning: could not download $asset" >&2
    fi
    rm -f "$asset_tmp"
  fi
done

user_unit="$HOME/.config/systemd/user/xray.service"
if [ -f "$user_unit" ]; then
  systemctl --user disable --now xray >/dev/null 2>&1 || true
  rm -f "$user_unit"
  systemctl --user daemon-reload >/dev/null 2>&1 || true
fi

tproxy_line=""
{{- if and (hasKey . "xrayTProxy") .xrayTProxy }}
tproxy_dir="/usr/local/etc/xray"
sudo mkdir -p "$tproxy_dir"

tproxy_port="10800"
if command -v jq >/dev/null 2>&1; then
  tproxy_port="$(jq -r '.ports.tproxy // 10800' "$xray_state")"
fi
printf 'TPROXY_PORT=%s\n' "$tproxy_port" | sudo tee "$tproxy_dir/tproxy.env" >/dev/null

tproxy_tmp="$(mktemp)"
cat >"$tproxy_tmp" <<'EOF'
#!/bin/sh
XRAY_STATE_FILE="{{ .chezmoi.homeDir }}/.config/xray/state.json"
TPROXY_PORT=10800
[ -r /usr/local/etc/xray/tproxy.env ] && . /usr/local/etc/xray/tproxy.env
if command -v jq >/dev/null 2>&1 && [ -r "$XRAY_STATE_FILE" ]; then
  state_port="$(jq -r '.ports.tproxy // empty' "$XRAY_STATE_FILE" 2>/dev/null)"
  if [ -n "$state_port" ]; then
    TPROXY_PORT="$state_port"
  fi
fi

tproxy_stop() {
  while ip rule del fwmark 1 table 100 2>/dev/null; do :; done
  ip route flush table 100 2>/dev/null
  iptables -t mangle -D PREROUTING -i waydroid0 -j XRAY_WD 2>/dev/null
  iptables -D INPUT -m mark --mark 1 -j ACCEPT 2>/dev/null
  iptables -t mangle -D PREROUTING -j XRAY 2>/dev/null
  iptables -t mangle -D OUTPUT -m owner ! --gid-owner 23333 -j XRAY_MASK 2>/dev/null
  iptables -t mangle -F XRAY_WD 2>/dev/null
  iptables -t mangle -X XRAY_WD 2>/dev/null
  iptables -t mangle -F XRAY 2>/dev/null
  iptables -t mangle -X XRAY 2>/dev/null
  iptables -t mangle -F XRAY_EX 2>/dev/null
  iptables -t mangle -X XRAY_EX 2>/dev/null
  iptables -t mangle -F XRAY_MASK 2>/dev/null
  iptables -t mangle -X XRAY_MASK 2>/dev/null
  iptables -t nat -D PREROUTING -j XRAY_DNS 2>/dev/null
  iptables -t nat -F XRAY_DNS 2>/dev/null
  iptables -t nat -X XRAY_DNS 2>/dev/null
  return 0
}

tproxy_start() {
  [ -w /proc/sys/net/bridge/bridge-nf-call-iptables ] && echo 0 > /proc/sys/net/bridge/bridge-nf-call-iptables
  ip rule add fwmark 1 table 100
  ip route add local 0.0.0.0/0 dev lo table 100

  iptables -t mangle -N XRAY 2>/dev/null || iptables -t mangle -F XRAY
  iptables -t mangle -A XRAY -m physdev --physdev-is-bridged -j RETURN
  iptables -t mangle -A XRAY -d 127.0.0.0/8 -j RETURN
  iptables -t mangle -A XRAY -d 10.0.0.0/8 -j RETURN
  iptables -t mangle -A XRAY -d 172.16.0.0/12 -j RETURN
  iptables -t mangle -A XRAY -d 192.168.0.0/16 -j RETURN
  iptables -t mangle -A XRAY -d 169.254.0.0/16 -j RETURN
  iptables -t mangle -A XRAY -d 100.64.0.0/10 -j RETURN
  iptables -t mangle -A XRAY -d 192.0.0.0/24 -j RETURN
  iptables -t mangle -A XRAY -d 192.0.2.0/24 -j RETURN
  iptables -t mangle -A XRAY -d 198.18.0.0/15 -j RETURN
  iptables -t mangle -A XRAY -d 198.51.100.0/24 -j RETURN
  iptables -t mangle -A XRAY -d 203.0.113.0/24 -j RETURN
  iptables -t mangle -A XRAY -d 224.0.0.0/4 -j RETURN
  iptables -t mangle -A XRAY -d 240.0.0.0/4 -j RETURN
  iptables -t mangle -A XRAY -p udp --dport 53 -j RETURN
  iptables -t mangle -A XRAY -p tcp --dport 53 -j RETURN
  iptables -t mangle -A XRAY -j RETURN -m mark --mark 0xff
  iptables -t mangle -A XRAY -p tcp -j TPROXY --on-ip 127.0.0.1 --on-port "$TPROXY_PORT" --tproxy-mark 1
  iptables -t mangle -A XRAY -p udp -j TPROXY --on-ip 127.0.0.1 --on-port "$TPROXY_PORT" --tproxy-mark 1

  iptables -t mangle -N XRAY_WD 2>/dev/null || iptables -t mangle -F XRAY_WD
  iptables -t mangle -A XRAY_WD -m physdev --physdev-is-bridged -j RETURN
  iptables -t mangle -A XRAY_WD -d 127.0.0.0/8 -j RETURN
  iptables -t mangle -A XRAY_WD -d 10.0.0.0/8 -j RETURN
  iptables -t mangle -A XRAY_WD -d 172.16.0.0/12 -j RETURN
  iptables -t mangle -A XRAY_WD -d 192.168.0.0/16 -j RETURN
  iptables -t mangle -A XRAY_WD -d 169.254.0.0/16 -j RETURN
  iptables -t mangle -A XRAY_WD -d 100.64.0.0/10 -j RETURN
  iptables -t mangle -A XRAY_WD -d 192.0.0.0/24 -j RETURN
  iptables -t mangle -A XRAY_WD -d 192.0.2.0/24 -j RETURN
  iptables -t mangle -A XRAY_WD -d 198.18.0.0/15 -j RETURN
  iptables -t mangle -A XRAY_WD -d 198.51.100.0/24 -j RETURN
  iptables -t mangle -A XRAY_WD -d 203.0.113.0/24 -j RETURN
  iptables -t mangle -A XRAY_WD -d 224.0.0.0/4 -j RETURN
  iptables -t mangle -A XRAY_WD -d 240.0.0.0/4 -j RETURN
  iptables -t mangle -A XRAY_WD -p udp --dport 53 -j RETURN
  iptables -t mangle -A XRAY_WD -p tcp --dport 53 -j RETURN
  iptables -t mangle -A XRAY_WD -j RETURN -m mark --mark 0xff
  iptables -t mangle -A XRAY_WD -p tcp -j TPROXY --on-ip 127.0.0.1 --on-port "$TPROXY_PORT" --tproxy-mark 1
  iptables -t mangle -A XRAY_WD -p udp -j TPROXY --on-ip 127.0.0.1 --on-port "$TPROXY_PORT" --tproxy-mark 1

  iptables -t mangle -A PREROUTING -i waydroid0 -j XRAY_WD
  iptables -t mangle -A PREROUTING -j XRAY

  iptables -C INPUT -m mark --mark 1 -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -m mark --mark 1 -j ACCEPT

  iptables -t mangle -N XRAY_MASK 2>/dev/null || iptables -t mangle -F XRAY_MASK
  iptables -t mangle -A XRAY_MASK -d 127.0.0.0/8 -j RETURN
  iptables -t mangle -A XRAY_MASK -d 10.0.0.0/8 -j RETURN
  iptables -t mangle -A XRAY_MASK -d 172.16.0.0/12 -j RETURN
  iptables -t mangle -A XRAY_MASK -d 192.168.0.0/16 -j RETURN
  iptables -t mangle -A XRAY_MASK -d 169.254.0.0/16 -j RETURN
  iptables -t mangle -A XRAY_MASK -d 100.64.0.0/10 -j RETURN
  iptables -t mangle -A XRAY_MASK -d 224.0.0.0/4 -j RETURN
  iptables -t mangle -A XRAY_MASK -d 240.0.0.0/4 -j RETURN
  iptables -t mangle -A XRAY_MASK -p udp --dport 53 -j RETURN
  iptables -t mangle -A XRAY_MASK -p tcp --dport 53 -j RETURN
  iptables -t mangle -A XRAY_MASK -j RETURN -m mark --mark 0xff
  iptables -t mangle -A XRAY_MASK -p tcp -j MARK --set-mark 1
  iptables -t mangle -A XRAY_MASK -p udp -j MARK --set-mark 1
  iptables -t mangle -A OUTPUT -m owner ! --gid-owner 23333 -j XRAY_MASK
  return 0
}

case "${1:-start}" in
start)
  tproxy_stop
  tproxy_start
  ;;
stop) tproxy_stop ;;
esac
exit 0
EOF
sudo install -m 0755 "$tproxy_tmp" "$tproxy_dir/tproxy.sh"
rm -f "$tproxy_tmp"

dispatcher_dir="/etc/NetworkManager/dispatcher.d"
if [ -d "$dispatcher_dir" ]; then
  dispatcher_tmp="$(mktemp)"
  cat >"$dispatcher_tmp" <<'EOF'
#!/bin/sh
case "$2" in
up | dhcp4-change | dhcp6-change) ;;
*) exit 0 ;;
esac
systemctl is-active --quiet xray || exit 0
/usr/local/etc/xray/tproxy.sh start
EOF
  sudo install -m 0755 "$dispatcher_tmp" "$dispatcher_dir/90-xray-tproxy"
  rm -f "$dispatcher_tmp"
fi

tproxy_line="ExecStartPre=$tproxy_dir/tproxy.sh start
ExecStopPost=$tproxy_dir/tproxy.sh stop"
{{- else }}
sudo rm -f /usr/local/etc/xray/tproxy.sh /usr/local/etc/xray/tproxy.env /etc/NetworkManager/dispatcher.d/90-xray-tproxy
{{- end }}

service_tmp="$(mktemp)"
cat >"$service_tmp" <<EOF
[Unit]
Description=Xray Service
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
User=root
Group=xray_tproxy
${tproxy_line}
ExecStart=$xray_bin run -c $xray_config
Restart=on-failure
RestartSec=3
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF
sudo install -m 0644 "$service_tmp" /etc/systemd/system/xray.service
rm -f "$service_tmp"

sudo systemctl daemon-reload
sudo systemctl enable xray
sudo systemctl restart xray
