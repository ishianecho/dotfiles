#!/usr/bin/env bash

set -euo pipefail

. "{{ .chezmoi.sourceDir }}/installers/lib/posix/env.sh"
. "{{ .chezmoi.sourceDir }}/installers/lib/posix/helpers.sh"

check_installed github-mcp-server || {
  echo "Warning: github-mcp-server is not installed; skipping MCP config." >&2
  exit 0
}
check_installed jq || {
  echo "Warning: jq is not installed; skipping MCP config." >&2
  exit 0
}

if [ -r "$HOME/.config/env" ]; then
  . "$HOME/.config/env"
fi

config="${CLAUDE_CONFIG_DIR:-$HOME/.config/claude}/.claude.json"
if [ ! -f "$config" ]; then
  exit 0
fi

tmp="$(mktemp)"
if jq \
  '.mcpServers.github = {command: "github-mcp-server", args: ["stdio"]} |
   .mcpServers.serena = {command: "serena", args: ["start-mcp-server", "--context=claude-code", "--project-from-cwd"]}' \
  "$config" >"$tmp"; then
  mv "$tmp" "$config"
else
  rm -f "$tmp"
fi
