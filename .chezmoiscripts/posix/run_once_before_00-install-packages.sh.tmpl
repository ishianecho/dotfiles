#!/usr/bin/env bash

set -euo pipefail

{{- $systemType := .chezmoi.os -}}
{{- $systemRelease := "" -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") -}}
{{-   $systemRelease = .chezmoi.osRelease.id -}}
{{- end }}
export DOTS_SYSTEM_TYPE='{{ $systemType }}'
export DOTS_SYSTEM_RELEASE='{{ $systemRelease }}'
export DOTS_INSTALL_SHELL='{{ if hasKey . "installShell" }}{{ .installShell }}{{ else }}true{{ end }}'
export DOTS_INSTALL_BUILD='{{ if hasKey . "installBuild" }}{{ .installBuild }}{{ else }}true{{ end }}'
export DOTS_INSTALL_RUNTIMES='{{ if hasKey . "installRuntimes" }}{{ .installRuntimes }}{{ else }}true{{ end }}'
export DOTS_INSTALL_EDITOR='{{ if hasKey . "installEditor" }}{{ .installEditor }}{{ else }}false{{ end }}'
export DOTS_INSTALL_AI='{{ if hasKey . "installAi" }}{{ .installAi }}{{ else }}false{{ end }}'
export DOTS_INSTALL_UTILITIES='{{ if hasKey . "installUtilities" }}{{ .installUtilities }}{{ else }}false{{ end }}'
export DOTS_INSTALL_OPERATIONS='{{ if hasKey . "installOperations" }}{{ .installOperations }}{{ else }}false{{ end }}'
export DOTS_INSTALL_TERMINAL='{{ if hasKey . "installTerminal" }}{{ .installTerminal }}{{ else }}false{{ end }}'
export DOTS_INSTALL_COMPLETIONS='{{ if hasKey . "installCompletions" }}{{ .installCompletions }}{{ else }}true{{ end }}'
export DOTS_INSTALL_INPUT='{{ if hasKey . "installInput" }}{{ .installInput }}{{ else }}false{{ end }}'
export DOTS_INSTALL_GAMING='{{ if hasKey . "installGaming" }}{{ .installGaming }}{{ else }}true{{ end }}'
export DOTS_INSTALL_COMMUNICATION='{{ if hasKey . "installCommunication" }}{{ .installCommunication }}{{ else }}false{{ end }}'
export DOTS_INSTALL_DESKTOP='{{ if hasKey . "installDesktop" }}{{ .installDesktop }}{{ else }}false{{ end }}'
{{- if eq .chezmoi.os "linux" }}
if command -v sudo >/dev/null 2>&1 && ! sudo -n true >/dev/null 2>&1; then
  echo "sudo credentials required for package installation; run 'sudo -v' then re-run"
  exit 0
fi
{{- end }}
exec "{{ .chezmoi.sourceDir }}/installers/main.sh" "$@"
