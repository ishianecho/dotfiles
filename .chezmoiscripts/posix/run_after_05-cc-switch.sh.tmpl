#!/usr/bin/env bash

set -euo pipefail

export CC_SWITCH_CONFIG_DIR="$HOME/.config/cc-switch"

if [ -r "$HOME/.config/env" ]; then
  . "$HOME/.config/env"
fi

provider_exists() {
  local app="$1" id="$2" output
  output="$(cc-switch --app "$app" provider list 2>/dev/null || true)"
  if [ -n "$output" ] && grep -qw -- "$id" <<<"$output"; then
    return 0
  fi
  sleep 1
  output="$(cc-switch --app "$app" provider list 2>/dev/null || true)"
  [ -n "$output" ] && grep -qw -- "$id" <<<"$output"
}

default_provider() {
  case "$1" in
  codex) printf '%s' "codex-official" ;;
  *) printf '%s' "claude-official" ;;
  esac
}

current_provider() {
  local app="$1" current
  current="$(cc-switch --app "$app" provider current 2>/dev/null | awk '/ID:/ { print $2; exit }' || true)"
  case "$current" in
  "" | default) printf '%s' "" ;;
  *) printf '%s' "$current" ;;
  esac
}

switch_provider() {
  local app="$1" provider="$2" fallback
  if ! provider_exists "$app" "$provider"; then
    fallback="$(default_provider "$app")"
    if provider_exists "$app" "$fallback"; then
      provider="$fallback"
    else
      return 0
    fi
  fi
  if ! cc-switch --app "$app" provider switch "$provider"; then
    echo "run_after_05-cc-switch: failed to switch $app provider, continuing" >&2
  fi
}

provider_config() {
  local app="$1" id="$2" key="$3" base="$4" model="$5" wire="$6" config
  if [ "$app" = claude ]; then
    jq -n --arg base "$base" --arg key "$key" --arg model "$model" \
      '{env: (if $model == "" then {ANTHROPIC_BASE_URL: $base, ANTHROPIC_AUTH_TOKEN: $key} else {ANTHROPIC_BASE_URL: $base, ANTHROPIC_AUTH_TOKEN: $key, ANTHROPIC_MODEL: $model} end)}'
    return
  fi
  config=""
  if [ -n "$model" ]; then
    config="model = \"$model\""$'\n'
  fi
  config+="model_provider = \"$id\""$'\n'
  config+='model_catalog_json = "~/.config/codex/models.json"'$'\n\n'
  config+="[model_providers.$id]"$'\n'
  config+="name = \"$id\""$'\n'
  config+="base_url = \"$base\""$'\n'
  config+="wire_api = \"$wire\""$'\n'
  jq -n --arg key "$key" --arg config "$config" '{auth: {OPENAI_API_KEY: $key}, config: $config}'
}

install_providers() {
  local app="$1" prefix base_suffix base_var key_var id key base model_var model wire_var wire cfg
  if [ "$app" = claude ]; then
    base_suffix="ANTHROPIC"
  else
    base_suffix="OPENAI"
  fi
  while IFS= read -r prefix; do
    key_var="${prefix}_API_KEY"
    key="${!key_var-}"
    [ -n "$key" ] || continue
    base_var="${prefix}_${base_suffix}_BASE_URL"
    base="${!base_var-}"
    [ -n "$base" ] || continue
    model_var="${prefix}_MODEL"
    model="${!model_var-}"
    wire_var="${prefix}_WIRE_API"
    wire="${!wire_var:-responses}"
    id="$(printf '%s' "$prefix" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
    provider_exists "$app" "$id" && continue
    cfg="$(mktemp)"
    provider_config "$app" "$id" "$key" "$base" "$model" "$wire" >"$cfg"
    cc-switch --app "$app" provider add \
      --id "$id" \
      --name "$id" \
      --config-file "$cfg" \
      --common-config
    rm -f "$cfg"
  done < <(env | sed -n 's/^\([A-Z0-9_]\{1,\}_API_KEY\)=.*/\1/p' | sed 's/_API_KEY$//' | sort -u)
}

context7_command="pnpm"
context7_args='"dlx", "@upstash/context7-mcp"'

set_codex_common() {
  local base="$CC_SWITCH_CONFIG_DIR/common-codex.toml" tmp
  if [ -z "${CONTEXT7_API_KEY:-}" ]; then
    cc-switch --app codex config common set --file "$base"
    return
  fi
  tmp="$(mktemp)"
  {
    cat "$base"
    printf '\n[mcp_servers.context7]\ncommand = "%s"\nargs = [%s]\n\n[mcp_servers.context7.env]\nCONTEXT7_API_KEY = "%s"\n' \
      "$context7_command" "$context7_args" "$CONTEXT7_API_KEY"
  } >"$tmp"
  cc-switch --app codex config common set --file "$tmp"
  rm -f "$tmp"
}

if ! command -v cc-switch >/dev/null 2>&1; then
  exit 0
fi

claude_provider="$(current_provider claude)"
codex_provider="$(current_provider codex)"

cc-switch --app claude config common set --file "$CC_SWITCH_CONFIG_DIR/common-claude.json"
set_codex_common

install_providers claude
install_providers codex

if [ -n "$claude_provider" ]; then
  switch_provider claude "$claude_provider"
fi
if [ -n "$codex_provider" ]; then
  switch_provider codex "$codex_provider"
fi
