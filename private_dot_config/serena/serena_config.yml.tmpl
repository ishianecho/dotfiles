{{- $shims := joinPath (joinPath .chezmoi.homeDir ".local/share") "mise/shims" -}}
{{- $serenaData := joinPath (joinPath .chezmoi.homeDir ".local/share") "serena/projects" -}}
# advanced configuration option allowing to configure language server-specific options.
# Maps the language key to the options.
# Have a look at the docstring of the constructors of the LS implementations within solidlsp (e.g., for C# or PHP) to see which options are available.
# No documentation on options means no options are available.
ls_specific_settings:
  bash:
    ls_path: {{ or (lookPath "bash-language-server") (joinPath $shims "bash-language-server") | quote }}
  cpp:
    ls_path: {{ or (lookPath "clangd") (joinPath $shims "clangd") | quote }}
  go:
    ls_path: {{ or (lookPath "gopls") (joinPath $shims "gopls") | quote }}
  groovy:
    ls_path: {{ or (lookPath "groovy-language-server") (joinPath $shims "groovy-language-server") | quote }}
  java:
    ls_path: {{ or (lookPath "jdtls") (joinPath $shims "jdtls") | quote }}
  json:
    ls_path: {{ or (lookPath "vscode-json-language-server") (joinPath $shims "vscode-json-language-server") | quote }}
  latex:
    ls_path: {{ or (lookPath "texlab") (joinPath $shims "texlab") | quote }}
  lua:
    ls_path: {{ or (lookPath "lua-language-server") (joinPath $shims "lua-language-server") | quote }}
  markdown:
    ls_path: {{ or (lookPath "marksman") (joinPath $shims "marksman") | quote }}
  rust:
    ls_path: {{ or (lookPath "rust-analyzer") (joinPath $shims "rust-analyzer") | quote }}
  toml:
    ls_path: {{ or (lookPath "taplo") (joinPath $shims "taplo") | quote }}
  typescript:
    ls_path: {{ or (lookPath "typescript-language-server") (joinPath $shims "typescript-language-server") | quote }}
  vue:
    ls_path: {{ or (lookPath "vue-language-server") (joinPath $shims "vue-language-server") | quote }}
  yaml:
    ls_path: {{ or (lookPath "yaml-language-server") (joinPath $shims "yaml-language-server") | quote }}
# template for the location of the per-project .serena data folder (memories, caches, etc.).
# Supports the following placeholders:
#   $projectDir         - the absolute path to the project root directory
#   $projectFolderName  - the name of the project directory
# Default: "$projectDir/.serena" (data stored inside the project directory)
# Example for a central location: "/projects-metadata/$projectFolderName/.serena"
project_serena_folder_location: "{{ $serenaData }}/$projectFolderName"
# whether to open the Dashboard window/browser tab when Serena starts (provided that `web_dashboard` is enabled).
# If set to false, you can still open the dashboard manually:
#  * When using an interface that supports a tray icon (see setting `web_dashboard_interface`),
#    you can conveniently open the dashboard from the system tray.
#  * When using the `browser` interface (no tray icon), so you can only open the dashboard by
#    a) telling the LLM to "open the dashboard" (provided that the open_dashboard tool is enabled) or by
#    b) manually navigating to http://localhost:24282/dashboard/ in your web browser (actual port
#       may be higher if you have multiple instances running; try ports 24283, 24284, etc.)
# Further information: https://oraios.github.io/serena/02-usage/060_dashboard.html
web_dashboard_open_on_launch: false
# the list of registered project paths (updated automatically).
projects: []
