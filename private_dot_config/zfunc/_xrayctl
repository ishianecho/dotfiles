#compdef xrayctl

_xrayctl() {
  local state_file="${XDG_CONFIG_HOME:-$HOME/.config}/xray/state.json"
  local -a commands
  commands=(
    'node:manage nodes'
    'route:manage routing rules'
    'port:manage listening ports'
    'status:show service state'
    'restart:regenerate and restart the service'
    'test:validate the generated configuration'
    'tproxy:show transparent-proxy state'
    'direct:run a command outside the transparent proxy'
    'init:import the legacy env file'
    '--no-restart:skip the service restart'
    '-h:show help'
    '--help:show help'
  )

  if (( CURRENT == 2 )); then
    _describe 'xrayctl command' commands
    return
  fi

  local -a tags matchers
  tags=(${(f)"$(jq -r '.nodes[].tag' "$state_file" 2>/dev/null)"})
  matchers=(${(f)"$(jq -r '.routes[].matcher' "$state_file" 2>/dev/null)"})

  case "${words[2]}" in
    node)
      if (( CURRENT == 3 )); then
        local -a node_subcommands
        node_subcommands=(
          'add:add a node'
          'rm:remove a node'
          'list:list nodes'
          'use:set the active node'
          'show:show node details'
          'set:update a node'
        )
        _describe 'node subcommand' node_subcommands
        return
      fi
      case "${words[3]}" in
        rm | use)
          _describe 'node tag' tags
          ;;
        show | set)
          if (( CURRENT == 4 )); then
            _describe 'node tag' tags
          elif [[ "${words[3]}" == set ]]; then
            _values 'option' '--address' '--port' '--uuid' '--sni' '--public-key' '--short-id'
          fi
          ;;
        add)
          _values 'option' '--use' '--address' '--port' '--uuid' '--sni' '--public-key' '--short-id'
          ;;
      esac
      ;;
    route)
      if (( CURRENT == 3 )); then
        local -a route_subcommands
        route_subcommands=(
          'add:add routing rules'
          'rm:remove a routing rule'
          'list:list routing rules'
        )
        _describe 'route subcommand' route_subcommands
        return
      fi
      case "${words[3]}" in
        add)
          if (( CURRENT == 4 )); then
            _values 'action' direct proxy block
          else
            _message 'matcher (domain: geosite: full: regexp: geoip: or IP/CIDR)'
          fi
          ;;
        rm)
          _describe 'route matcher' matchers
          ;;
      esac
      ;;
    port)
      if (( CURRENT == 3 )); then
        _values 'port subcommand' set
      elif (( CURRENT == 4 )); then
        _values 'option' '--socks' '--tproxy'
      fi
      ;;
    tproxy)
      if (( CURRENT == 3 )); then
        _values 'tproxy subcommand' status
      fi
      ;;
  esac
}

compdef _xrayctl xrayctl
