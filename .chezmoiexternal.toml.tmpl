{{- $origin := output "git" "-C" .chezmoi.sourceDir "remote" "-v" -}}
{{- $useSSH := regexMatch "(?m)^origin[[:space:]]+(git@|ssh://|git\\+ssh://)" $origin -}}
{{- $installFonts := true -}}
{{- if hasKey . "installFonts" -}}
{{-   $installFonts = .installFonts -}}
{{- end -}}
[".config/nvim"]
type = "git-repo"
{{ if $useSSH }}
url = "git@github.com:ishianecho/ishian.nvim.git"
{{ else }}
url = "https://github.com/ishianecho/ishian.nvim.git"
{{ end }}

{{ if $installFonts }}
[fonts]
type = "archive"
url = "https://github.com/ishianecho/assets/releases/download/fonts-v1.0/fonts.tar.xz"
{{ if eq .chezmoi.os "darwin" }}
targetPath = "Library/Fonts"
{{ else if eq .chezmoi.os "linux" }}
targetPath = ".local/share/fonts"
{{ else if eq .chezmoi.os "windows" }}
targetPath = "AppData/Local/Microsoft/Windows/Fonts"
{{ end }}
include = ["*.ttf"]
{{ end }}

{{ if eq .chezmoi.os "windows" }}
[".local/bin/proxy.ps1"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/win/proxy.ps1"
[".local/bin/updnvim.ps1"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/win/updnvim.ps1"
[".local/bin/xrayctl.ps1"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/win/xrayctl.ps1"
{{ end }}
[".local/bin/ghf"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/ghf"
executable = true
[".local/bin/proxy"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/proxy"
executable = true
[".local/bin/updnvim"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/updnvim"
executable = true
[".local/bin/xrayctl"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/xrayctl"
executable = true
[".local/bin/completion"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/completion"
executable = true
