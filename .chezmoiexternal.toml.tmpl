{{- $origin := output "git" "-C" .chezmoi.sourceDir "remote" "-v" -}}
{{- $useSSH := regexMatch "(?m)^origin[[:space:]]+(git@|ssh://|git\\+ssh://)" $origin -}}
{{- $installFonts := true -}}
{{- if hasKey . "installFonts" -}}
{{-   $installFonts = .installFonts -}}
{{- end -}}
[".config/nvim"]
type = "git-repo"
{{ if $useSSH }}
url = "git@github.com:ishianecho/ishian.nvim.git"
{{ else }}
url = "https://github.com/ishianecho/ishian.nvim.git"
{{ end }}

{{ if $installFonts }}
[fonts]
type = "archive"
url = "https://github.com/ishianecho/assets/releases/download/fonts-v2.1/fonts.tar.xz"
{{ if eq .chezmoi.os "darwin" }}
targetPath = "Library/Fonts"
{{ else if eq .chezmoi.os "linux" }}
targetPath = ".local/share/fonts"
{{ else if eq .chezmoi.os "windows" }}
targetPath = "AppData/Local/Microsoft/Windows/Fonts"
{{ end }}
include = ["*.ttf"]
{{ end }}

{{ if eq .chezmoi.os "windows" }}
[".local/bin/updnvim.ps1"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/win/updnvim.ps1"
{{ end }}
[".local/bin/ghf"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/ghf"
executable = true
[".local/bin/updnvim"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/updnvim"
executable = true
[".local/bin/completion"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/completion"
executable = true
{{ if ne .chezmoi.os "windows" }}
[".local/bin/notify"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/notify"
executable = true
[".local/bin/port"]
type = "file"
url = "https://raw.githubusercontent.com/ishianecho/bin/main/posix/port"
executable = true
{{ end }}
{{ $ext := "" }}
{{ if eq .chezmoi.os "windows" }}
{{   $ext = ".exe" }}
{{ end }}
[".local/bin/proxy{{ $ext }}"]
type = "file"
url = "https://github.com/ishianecho/bin/releases/latest/download/proxy-{{ .chezmoi.os }}-{{ .chezmoi.arch }}{{ $ext }}"
executable = true
[".local/bin/xrayctl{{ $ext }}"]
type = "file"
url = "https://github.com/ishianecho/bin/releases/latest/download/xrayctl-{{ .chezmoi.os }}-{{ .chezmoi.arch }}{{ $ext }}"
executable = true
