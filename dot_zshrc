. "$HOME/.config/shell/msys2-path"

if [[ -n "${WT_SESSION:-}" ]]; then
  __wt_report_cwd() {
    local wt_cwd="$PWD"
    if command -v cygpath >/dev/null 2>&1; then
      wt_cwd="$(cygpath -w "$PWD")"
    fi
    printf '\e]9;9;"%s"\e\\' "$wt_cwd"
  }
  if ((! ${precmd_functions[(Ie)__wt_report_cwd]})); then
    precmd_functions+=(__wt_report_cwd)
  fi
fi

ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
  mkdir -p "$(dirname "$ZINIT_HOME")"
  git clone https://github.com/zdharma-continuum/zinit "$ZINIT_HOME"
fi
source "$ZINIT_HOME/zinit.zsh"

source "$XDG_CONFIG_HOME/zsh/opt.zsh"

alias grep='grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn,.idea,.tox,.venv,venv}'
alias egrep='grep -E'
alias fgrep='grep -F'

fpath=("$XDG_CONFIG_HOME/zfunc" "$XDG_DATA_HOME/zsh/site-functions" $fpath)
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
[[ -n "$LS_COLORS" ]] && zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

VI_MODE_RESET_PROMPT_ON_MODE_CHANGE=true
VI_MODE_SET_CURSOR=true
zinit snippet OMZP::vi-mode

zinit light zsh-users/zsh-completions
autoload -Uz compinit
mkdir -p "$XDG_CACHE_HOME/zsh"
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump"
zinit snippet OMZL::clipboard.zsh
zinit snippet OMZL::directories.zsh
zinit snippet OMZP::git
zinit snippet OMZP::gradle
zinit snippet OMZP::sudo
zinit snippet OMZP::extract
zinit snippet OMZP::z
zinit light Aloxaf/fzf-tab
zinit light zsh-users/zsh-autosuggestions
zinit light hlissner/zsh-autopair
zinit light zsh-users/zsh-syntax-highlighting

autoload -Uz vcs_info
precmd_functions+=(vcs_info)
zstyle ':vcs_info:git:*' formats '(%b) '
PROMPT='%F{red}>>%f%B%F{red}>%f%b %B%F{cyan}%c%f%b %B%F{blue}${vcs_info_msg_0_}%f%b'

[ -f "$XDG_CONFIG_HOME/fzf/fzf.zsh" ] && source "$XDG_CONFIG_HOME/fzf/fzf.zsh"
source "$XDG_CONFIG_HOME/zsh/keybinds.zsh"
source "$XDG_CONFIG_HOME/zsh/kitty.zsh"

case ":$PATH:" in
*":$MISE_DATA_DIR/shims:"*) ;;
*) export PATH="$MISE_DATA_DIR/shims:$PATH" ;;
esac

alias n='nvim'

npx() {
  if [ -n "$1" ] && [ -x "./node_modules/.bin/$1" ]; then
    pnpm exec "$@"
  else
    pnpm dlx "$@"
  fi
}

. "$XDG_CONFIG_HOME/shell/completions"
compdef _gradle gradlew ./gradlew
compdef -d gradle gw
