[user]
	name = Ishian
	email = ishio.liu@outlook.com
[core]
	editor = nvim
[url "git@github.com:"]
	insteadOf = https://github.com/
[init]
	defaultBranch = main
[alias]
	aa = add -A
	au = add -u
	ap = add -p
	av = add -v
	diffn = diff --name-only
	review = diff main...HEAD
	br = branch -vv
	ba = branch -a
	last = switch -
	ll = log --pretty=format:'%C(yellow)%h %C(blue)%ad %C(green)%an %Creset%s' --date=short
	lg = log --oneline --graph --decorate --all
	recent = log --oneline -10
	cm = commit -m
	amend = commit --amend
	nb = switch -c
	dw = diff --word-diff
	diffs = diff --staged
	st = status -sb
	bl = blame
	bll = blame -L
[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[diff]
	tool = nvimdiff
[difftool]
	prompt = false
[merge]
	conflictStyle = zdiff3
