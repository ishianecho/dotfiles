#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat << 'EOF'
Usage: set-proxy [options] [HTTP_PROXY [SOCKS_PROXY]]

Options:
  --http <url>        HTTP/HTTPS proxy, for example http://127.0.0.1:10808
  --socks <url>       SOCKS proxy, for example socks5://127.0.0.1:10808
  --no-proxy <list>   Comma-separated hosts which bypass the proxy
  --clear             Remove all proxy settings
  --show              Show the saved proxy configuration
  --sync              Re-apply the saved configuration to the environment
  -h, --help          Show this help

The configuration is stored in ~/.config/proxy/config. Shell sessions read
that file directly; no per-tool proxy configuration is written.
EOF
}

die() {
  printf 'set-proxy: %s\n' "$1" >&2
  exit 1
}

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/proxy"
config_file="$config_dir/config"

validate_url() {
  local value="$1" name="$2" scheme

  case "$value" in
    '') return 0 ;;
    http://* | https://* | socks5://* | socks5h://*) ;;
    *) die "$name must use http://, https://, socks5://, or socks5h://" ;;
  esac

  case "$value" in
    *[[:space:]]* | *'"'* | *"'"* | *\\*)
      die "$name must not contain whitespace, quotes, or backslashes"
      ;;
  esac

  scheme="${value%%://*}"
  if [ "$name" = SOCKS_PROXY ] && { [ "$scheme" = http ] || [ "$scheme" = https ]; }; then
    die "SOCKS_PROXY must use socks5:// or socks5h://"
  fi
  if [ "$name" = HTTP_PROXY ] && { [ "$scheme" = socks5 ] || [ "$scheme" = socks5h ]; }; then
    die "HTTP_PROXY must use http:// or https://"
  fi
}

write_config() {
  local http="$1" socks="$2" no_proxy="$3" temporary

  case "$no_proxy" in
    *[[:cntrl:]]*) die "--no-proxy must be a single comma-separated line" ;;
  esac

  mkdir -p "$config_dir"
  temporary="$(mktemp "$config_dir/config.XXXXXX")"
  trap 'rm -f "$temporary"' EXIT
  {
    printf "PROXY_HTTP='%s'\\n" "$http"
    printf "PROXY_SOCKS='%s'\\n" "$socks"
    printf "PROXY_NO_PROXY='%s'\\n" "$no_proxy"
  } > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$config_file"
  trap - EXIT
}

read_config() {
  [ -r "$config_file" ] || die "No proxy configuration found at $config_file"
  . "$config_file"
  PROXY_HTTP="${PROXY_HTTP:-}"
  PROXY_SOCKS="${PROXY_SOCKS:-}"
  PROXY_NO_PROXY="${PROXY_NO_PROXY:-}"
}

apply_environment() {
  if [ -n "$PROXY_HTTP" ]; then
    export HTTP_PROXY="$PROXY_HTTP" HTTPS_PROXY="$PROXY_HTTP"
    export http_proxy="$PROXY_HTTP" https_proxy="$PROXY_HTTP"
  else
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
  fi

  if [ -n "$PROXY_SOCKS" ]; then
    export ALL_PROXY="$PROXY_SOCKS" all_proxy="$PROXY_SOCKS"
  else
    unset ALL_PROXY all_proxy
  fi

  if [ -n "$PROXY_HTTP" ] || [ -n "$PROXY_SOCKS" ]; then
    export NO_PROXY="${PROXY_NO_PROXY:-localhost,127.0.0.1,::1}"
    export no_proxy="$NO_PROXY"
  else
    unset NO_PROXY no_proxy
  fi
}

sync_consumers() {
  printf 'Proxy configuration: %s\n' "$config_file"
}

http=""
socks=""
no_proxy=""
mode="set"
action_count=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --http | --socks | --no-proxy)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      case "$1" in
        --http) http="$2" ;;
        --socks) socks="$2" ;;
        --no-proxy) no_proxy="$2" ;;
      esac
      shift 2
      ;;
    --clear)
      mode=clear
      action_count=$((action_count + 1))
      shift
      ;;
    --show)
      mode=show
      action_count=$((action_count + 1))
      shift
      ;;
    --sync)
      mode=sync
      action_count=$((action_count + 1))
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --*)
      usage >&2
      exit 2
      ;;
    *)
      if [ -z "$http" ]; then
        http="$1"
      elif [ -z "$socks" ]; then
        socks="$1"
      else
        usage >&2
        exit 2
      fi
      shift
      ;;
  esac
done

[ "$action_count" -le 1 ] || die "Specify only one of --clear, --show, or --sync"
if [ "$mode" != set ] && { [ -n "$http" ] || [ -n "$socks" ] || [ -n "$no_proxy" ]; }; then
  die "Proxy URLs and --no-proxy cannot be combined with --$mode"
fi

case "$mode" in
  show)
    [ -r "$config_file" ] || die "No proxy configuration found at $config_file"
    cat "$config_file"
    ;;
  clear)
    write_config "" "" ""
    read_config
    apply_environment
    sync_consumers
    ;;
  sync)
    read_config
    apply_environment
    sync_consumers
    ;;
  set)
    [ -n "$http" ] || [ -n "$socks" ] || {
      usage >&2
      exit 2
    }
    validate_url "$http" HTTP_PROXY
    validate_url "$socks" SOCKS_PROXY
    [ -n "$no_proxy" ] || no_proxy="localhost,127.0.0.1,::1"
    write_config "$http" "$socks" "$no_proxy"
    read_config
    apply_environment
    sync_consumers
    ;;
esac
