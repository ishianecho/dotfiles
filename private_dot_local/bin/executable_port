#!/bin/sh

if [ "${1:-}" = clear ]; then
  shift
  if [ -n "$1" ]; then
    port_num="$(lsof -ti4TCP:"$1")"
    if [ $? -eq 0 ]; then
      kill "$port_num"
    fi
  else
    echo >&2 Usage: port clear port-number
    exit 1
  fi
elif [ -n "$1" ]; then
  lsof -ni4TCP:"$1"
else
  echo >&2 "Usage: port port-number"
  echo >&2 "       port clear port-number"
  exit 1
fi
