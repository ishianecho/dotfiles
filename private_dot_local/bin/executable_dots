#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat << 'EOF'
Usage: dots <command> [args]

Commands:
  init                Reinitialize chezmoi, reset script state, and apply
  apply               Apply the current chezmoi state
  diff                Show pending changes
  status              Show chezmoi status
  edit                Open the source in the configured editor
  update              Pull the source repository and apply
  update --init       Pull, reinitialize, reset script state, and apply
  doctor              Run chezmoi doctor
  install <target>    Install a package or a curated group
  proxy [args]        Run set-proxy

Options (accepted by non-proxy commands):
  --proxy <url>       Set the HTTP/HTTPS proxy before running the command
  --socks <url>       Set the SOCKS proxy before running the command
  --no-proxy <list>   Set hosts which bypass the proxy
  --clear-proxy       Clear the proxy before running the command

Install groups:
  shell, build, runtimes, editor, tools, operations, ai, terminal, input, all

Examples:
  dots init
  dots init --proxy http://127.0.0.1:10808 --socks socks5://127.0.0.1:10808
  dots install zsh
  dots install input
  dots install dev
  dots proxy http://127.0.0.1:10808 socks5://127.0.0.1:10808
EOF
}

run_installer() {
  local init_script
  init_script="$(source_dir)/installers/packages/posix/00-init.sh"
  if [ -f "$init_script" ]; then
    bash -c 'source "$1"; source "$2"' bash "$init_script" "$1"
  else
    bash "$1"
  fi
}

source_dir() {
  chezmoi source-path
}

reset_script_state() {
  local output
  if ! output="$(chezmoi state delete-bucket --bucket=scriptState 2>&1)"; then
    if [[ "$output" != *"bucket not found"* ]]; then
      echo "chezmoi state delete-bucket failed: $output" >&2
      return 1
    fi
  fi
}

prime_sudo() {
  [ "$(uname -s)" = Linux ] || return 0
  command -v sudo >/dev/null 2>&1 || return 0
  sudo -n true 2>/dev/null && return 0
  echo "Some setup scripts require sudo; caching credentials..."
  sudo -v || echo "Warning: sudo unavailable; privileged steps will be skipped" >&2
}

restore_fcitx5() {
  local restart_marker="${XDG_RUNTIME_DIR:-/tmp}/dots-fcitx5-restart"
  [ -f "$restart_marker" ] || return 0
  rm -f "$restart_marker"
  command -v fcitx5 >/dev/null 2>&1 || return 0
  local flags=(-d)
  if [[ "$(uname -r)" == *[Mm]icrosoft* ]]; then
    flags=(--disable=wayland --replace -d)
  fi
  nohup fcitx5 "${flags[@]}" >/dev/null 2>&1 &
}

restore_xray() {
  [ "$(uname -s)" = Linux ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl is-enabled --quiet xray 2>/dev/null || return 0
  if systemctl is-active --quiet xray 2>/dev/null; then
    return 0
  fi
  if ! sudo -n systemctl start xray >/dev/null 2>&1; then
    echo "Warning: xray service stopped; run 'sudo systemctl start xray'" >&2
  fi
}

restore_on_exit() {
  local status=$?
  trap - EXIT INT TERM
  restore_fcitx5
  restore_xray
  exit "$status"
}

init_dots() {
  prime_sudo
  chezmoi init "$@"
  reset_script_state
  chezmoi apply
}

proxy_script_path() {
  local proxy_script="$script_dir/set-proxy"
  [ -x "$proxy_script" ] || proxy_script="$HOME/.local/bin/set-proxy"
  printf '%s\n' "$proxy_script"
}

load_proxy_environment() {
  local proxy_config="${XDG_CONFIG_HOME:-$HOME/.config}/proxy/config"
  [ -r "$proxy_config" ] || return 0
  . "$proxy_config"
  PROXY_HTTP="${PROXY_HTTP:-}"
  PROXY_SOCKS="${PROXY_SOCKS:-}"
  if [ -n "$PROXY_HTTP" ]; then
    export HTTP_PROXY="$PROXY_HTTP" HTTPS_PROXY="$PROXY_HTTP"
    export http_proxy="$PROXY_HTTP" https_proxy="$PROXY_HTTP"
  else
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
  fi
  if [ -n "$PROXY_SOCKS" ]; then
    export ALL_PROXY="$PROXY_SOCKS" all_proxy="$PROXY_SOCKS"
  else
    unset ALL_PROXY all_proxy
  fi
  if [ -n "$PROXY_HTTP" ] || [ -n "$PROXY_SOCKS" ]; then
    export NO_PROXY="${PROXY_NO_PROXY:-localhost,127.0.0.1,::1}"
    export no_proxy="$NO_PROXY"
  else
    unset NO_PROXY no_proxy
  fi
  unset PROXY_HTTP PROXY_SOCKS PROXY_NO_PROXY
}

find_installer() {
  local target="$1"
  local package_dir
  package_dir="$(source_dir)/installers/packages/posix"
  find "$package_dir" -maxdepth 1 -type f -name "*-${target}.sh" -print -quit
}

install_group() {
  local group="$1"
  local package_dir
  package_dir="$(source_dir)/installers/packages/posix"
  local packages=()
  local prefixes=()

  case "$group" in
    shell)
      prefixes=(0?)
      ;;
    build)
      prefixes=(1? 2?)
      ;;
    runtimes)
      prefixes=(3?)
      ;;
    editor)
      prefixes=(4?)
      ;;
    ai)
      prefixes=(5?)
      ;;
    tools | dev)
      prefixes=(6?)
      ;;
    operations)
      prefixes=(7?)
      ;;
    terminal)
      prefixes=(8?)
      ;;
    input)
      prefixes=(9?)
      ;;
    all)
      run_installer "$(source_dir)/installers/main.sh"
      return
      ;;
    *)
      echo "Unknown install group: $group" >&2
      usage >&2
      exit 2
      ;;
  esac

  local prefix
  for prefix in "${prefixes[@]}"; do
    while IFS= read -r installer; do
      echo "==> Installing $(basename "$installer" .sh)"
      run_installer "$installer"
    done < <(find "$package_dir" -maxdepth 1 -type f -name "${prefix}-*.sh" | sort)
  done
}

if [ "${1:-}" = proxy ]; then
  shift
  exec "$(proxy_script_path)" "$@"
fi

trap 'restore_on_exit' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

command_args=()
proxy_args=()
proxy_clear=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --proxy)
      [ "$#" -ge 2 ] || {
        echo "--proxy requires a URL" >&2
        exit 2
      }
      proxy_args+=(--http "$2")
      shift 2
      ;;
    --socks)
      [ "$#" -ge 2 ] || {
        echo "--socks requires a URL" >&2
        exit 2
      }
      proxy_args+=(--socks "$2")
      shift 2
      ;;
    --no-proxy)
      [ "$#" -ge 2 ] || {
        echo "--no-proxy requires a list" >&2
        exit 2
      }
      proxy_args+=(--no-proxy "$2")
      shift 2
      ;;
    --clear-proxy)
      proxy_clear=true
      shift
      ;;
    --)
      shift
      command_args+=("$@")
      break
      ;;
    *)
      command_args+=("$1")
      shift
      ;;
  esac
done

if [ "$proxy_clear" = true ]; then
  [ "${#proxy_args[@]}" -eq 0 ] || {
    echo "--clear-proxy cannot be combined with other proxy options" >&2
    exit 2
  }
  proxy_args=(--clear)
fi

if [ "${#proxy_args[@]}" -gt 0 ]; then
  "$(proxy_script_path)" "${proxy_args[@]}"
  load_proxy_environment
fi

set -- "${command_args[@]}"

case "${1:-help}" in
  init)
    shift
    init_dots "$@"
    ;;
  apply)
    shift
    prime_sudo
    chezmoi apply "$@"
    ;;
  diff)
    shift
    exec chezmoi diff "$@"
    ;;
  status)
    shift
    exec chezmoi status "$@"
    ;;
  edit)
    shift
    exec chezmoi edit "$@"
    ;;
  update)
    shift
    update_init=false
    update_args=()
    for arg in "$@"; do
      if [ "$arg" = "--init" ]; then
        update_init=true
      else
        update_args+=("$arg")
      fi
    done
    git -C "$(source_dir)" pull --ff-only
    if [ "$update_init" = true ]; then
      if [ "${#update_args[@]}" -gt 0 ]; then
        init_dots "${update_args[@]}"
      else
        init_dots
      fi
    else
      prime_sudo
      if [ "${#update_args[@]}" -gt 0 ]; then
        chezmoi apply "${update_args[@]}"
      else
        chezmoi apply
      fi
    fi
    ;;
  doctor)
    shift
    exec chezmoi doctor "$@"
    ;;
  proxy)
    shift
    exec "$(proxy_script_path)" "$@"
    ;;
  install)
    shift
    if [ "$#" -eq 0 ]; then
      echo "dots install requires a package or group name" >&2
      exit 2
    fi

    target="$1"
    shift

    case "$target" in
      shell | build | runtimes | editor | tools | dev | operations | ai | terminal | input | all)
        install_group "$target"
        ;;
      *)
        installer="$(find_installer "$target")"
        if [ -z "$installer" ]; then
          echo "Installer not found for target: $target" >&2
          exit 1
        fi
        echo "==> Installing $target"
        run_installer "$installer"
        ;;
    esac
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
