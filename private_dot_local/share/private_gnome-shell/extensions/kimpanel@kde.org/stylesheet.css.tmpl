.popup-menu-boxpointer.kimpanel-popup-boxpointer {
}

.popup-menu-content.kimpanel-popup-content {
  background-color: #ffffff;
  border-radius: 10px;
  border: 1px solid rgba(0, 0, 0, 0.1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  padding: 4px;
}

.kimpanel-label {
  font-family: sans;
  font-weight: normal;
  color: #333333;
  padding: 6px 12px;
  font-size: {{ .fontSize }}px;
}

.kimpanel-candidate-item {
  cursor: pointer;
  transition-duration: 0ms;
}

.kimpanel-candidate-item:hover {
  border-radius: 6px;
  background-color: #007aff;
  color: #ffffff;
}

.kimpanel-candidate-item:active {
  border-radius: 6px;
  background-color: #0062cc;
  color: #ffffff;
}

.kimpanel-candidate-item:active:hover {
}

.minwidth-zero {
  min-width: 0;
}

.icon-disable {
  color: rgba(150, 150, 150, 0.5);
}
